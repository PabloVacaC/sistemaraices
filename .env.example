# =========================================================================
# CONFIGURACIÓN DE PRODUCCIÓN / DESPLIEGUE - SISTEMAS RAÍCES
# Copia este archivo como '.env' en la raíz y ajusta tus contraseñas seguras.
# =========================================================================

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=coloca_aqui_tu_password_seguro_produccion
POSTGRES_DB=sistemraices_db
POSTGRES_PORT=5432

# Backend FastAPI
APP_NAME=SISTEMAS_RAICES
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:coloca_aqui_tu_password_seguro_produccion@db:5432/sistemraices_db

# Seguridad JWT (Genera una clave aleatoria de al menos 32 caracteres)
# Ejemplo para generar clave: openssl rand -hex 32
JWT_SECRET_KEY=coloca_aqui_tu_clave_secreta_jwt_unica_y_segura
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Orígenes CORS permitidos (separados por coma, sin espacios)
# Para producción, coloca tu dominio: https://erp.tudominio.com,https://tudominio.com
CORS_ORIGINS=http://localhost:4200,http://localhost,http://127.0.0.1:4200,http://localhost:80

